{
  "name": "agents-system",
  "private": true,
  "type": "module",
  "description": "Versioned Claude Code agent kit: research, plan, approve, build, review, merge, retro.",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test kit/scripts/tests/*.test.js",
    "planted-faults": "node planted-faults/run.js",
    "audit": "node audit/boards.js",
    "architecture": "node kit/scripts/arch_manifest.js",
    "architecture:update": "node kit/scripts/arch_manifest.js --out kit/architecture.json",
    "architecture:check": "node kit/scripts/arch_manifest.js --check kit/architecture.json"
  }
}
