#!/bin/sh
# agent-kit launcher (generated by install.sh from kit/bin/kit.in; do not edit the installed copy).
# `kit <script> [args...]` runs one of the kit's scripts: `kit lane next-step <slug> --repo .`.
# Why it exists (#63): Claude Code matches a permission rule against the command text, and it does not approve a rule
# written with "$HOME" (probe on Claude Code 2.1.328, 2026-11-22: `Bash(node "$HOME/.claude/kit/scripts/*)` denied the
# identical command; `Bash(kit *)` approved `kit ...`). So agents call the kit through this one plain command.
KIT_DIR='@KIT_DIR@'
name="${1:-}"
case "$name" in
  ''|-h|--help) echo "usage: kit <script> [args...]   (a script in $KIT_DIR/scripts, named without .js)" >&2; exit 64 ;;
  *[!a-z0-9_]*) echo "kit: '$name' is not a kit script name (lowercase letters, digits and _ only)" >&2; exit 64 ;;
esac
shift
script="$KIT_DIR/scripts/$name.js"
if [ ! -f "$script" ]; then echo "kit: no script '$name' in $KIT_DIR/scripts" >&2; exit 64; fi
exec node "$script" "$@"
