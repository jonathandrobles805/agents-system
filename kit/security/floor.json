{
  "$comment": "The security floor: the minimum every project enforces (KIT-SPEC 10.9, decision 0008). Kit-owned. A project may ADD to each list through .claude/kit.json (secret_patterns, extra deny) and never remove; ci_security_floor.js fails on any loosening, and the guard hooks read this file directly so a loosened settings.json changes nothing at run time.",
  "version": 1,
  "deny": [
    "Read(.env)",
    "Read(.env.*)",
    "Read(**/*.pem)",
    "Read(**/*.key)",
    "Read(**/id_rsa*)",
    "Read(**/secrets/**)",
    "Read(**/credentials*)",
    "Read(**/.aws/**)",
    "Read(**/.ssh/**)",
    "Edit(.claude/**)",
    "Edit(.github/workflows/**)",
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(git reset --hard*)",
    "Bash(sudo *)",
    "Bash(rm -rf /*)",
    "Bash(gh pr merge *)",
    "Bash(gh pr review *--approve*)",
    "Bash(gh pr review -a *)",
    "Bash(gh pr review * -a)",
    "Bash(gh pr review * -a *)",
    "Bash(gh api *pulls/*/merge*)",
    "Bash(gh api *pulls/*/reviews*)",
    "Bash(gh api *repos/*/merges*)",
    "Bash(gh api *branches/*/protection*)",
    "Bash(gh api *rulesets*)",
    "Bash(gh api graphql *mergePullRequest*)",
    "Bash(gh api graphql *enablePullRequestAutoMerge*)",
    "Bash(gh api graphql *mergeBranch*)",
    "Bash(gh api graphql *PullRequestReview*)",
    "Bash(gh api graphql *BranchProtectionRule*)",
    "Bash(gh api graphql *RepositoryRuleset*)"
  ],
  "secret_read_patterns": [
    ".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "id_rsa*", "id_ed25519*", "*.keystore",
    "**/secrets/**", "**/secret/**", "**/credentials*", "**/.aws/**", "**/.ssh/**", "**/.gnupg/**",
    "**/*token*.json", "**/service-account*.json", "**/.netrc", "**/.npmrc", "**/.pypirc",
    "**/.config/gh/**", "**/.kube/config", "**/.docker/config.json", "**/.azure/**", "**/.config/gcloud/**"
  ],
  "credential_patterns": [
    "AKIA[0-9A-Z]{16}",
    "sk_live_[0-9a-zA-Z]{10,}",
    "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "ghp_[0-9A-Za-z]{20,}",
    "github_pat_[0-9A-Za-z_]{20,}",
    "xox[baprs]-[0-9A-Za-z-]{10,}",
    "AIza[0-9A-Za-z_-]{30,}",
    "postgres(ql)?://[^:\\s]+:[^@\\s]+@",
    "mysql://[^:\\s]+:[^@\\s]+@",
    "mongodb(\\+srv)?://[^:\\s]+:[^@\\s]+@",
    "sk-ant-[0-9A-Za-z_-]{20,}"
  ],
  "network": {
    "$comment": "Allowlist the sandbox enforces for every lane (step 2b). Package registries plus what the lane's own spec declares under its `## Network` section; the spec is the only way to widen it. There is deliberately no per-agent list: the sandbox boundary is the lane process and the kit's agents are subagents inside one lane session, so a role cannot have a network of its own.",
    "default_allow": [
      "registry.npmjs.org", "registry.yarnpkg.com", "pypi.org", "files.pythonhosted.org",
      "proxy.golang.org", "sum.golang.org", "index.crates.io", "static.crates.io", "github.com", "api.github.com", "objects.githubusercontent.com"
    ]
  },
  "second_family": null,
  "max_researchers": 8
}
