{
  "id": "retro-lesson-names-enforcement",
  "role": "retro",
  "tags": [
    "smoke"
  ],
  "fixture": "node-api",
  "setup": {
    "files": {
      "src/text/format.ts": {
        "from": "setups/truncate-text/format.ts"
      },
      "tests/format.test.ts": {
        "from": "setups/truncate-text/format.test.ts"
      },
      "docs/specs/truncate-text.md": {
        "from": "setups/truncate-text/spec.approved.md"
      },
      "ROADMAP.md": {
        "from": "setups/truncate-text/roadmap.md"
      }
    },
    "lane": {
      "slug": "truncate-text",
      "steps": [
        {
          "stage": "test"
        },
        {
          "write": {
            "tests/truncate.test.ts": {
              "from": "setups/truncate-text/truncate.test.ts"
            }
          }
        },
        {
          "check": "D1",
          "command": "npx vitest run --reporter=tap tests/truncate.test.ts",
          "record": "red"
        },
        {
          "stage": "build"
        },
        {
          "hook": "hook_guard_edit.js",
          "tool": "Write",
          "tool_input": {
            "file_path": "src/text/ellipsis.ts",
            "content": "export const ELLIPSIS = '…';\n"
          },
          "exit": 2
        },
        {
          "write": {
            "src/text/format.ts": {
              "from": "setups/truncate-text/format.off-by-one.ts"
            }
          }
        },
        {
          "check": "D1",
          "command": "npx vitest run --reporter=tap tests/truncate.test.ts",
          "record": "green"
        },
        {
          "commit": "truncate-text: D1 truncate shortens long text"
        },
        {
          "stage": "review"
        },
        {
          "write": {
            "tests/truncate.test.ts": {
              "from": "setups/truncate-text/truncate.adversarial.test.ts"
            },
            "docs/specs/truncate-text.review.md": {
              "from": "setups/truncate-text/review.round1-fail.md"
            }
          }
        },
        {
          "commit": "truncate-text: review round 1, FAIL R11 R13"
        },
        {
          "stage": "build"
        },
        {
          "write": {
            "src/text/format.ts": {
              "from": "setups/truncate-text/format.done.ts"
            }
          }
        },
        {
          "check": "D1",
          "command": "npx vitest run --reporter=tap tests/truncate.test.ts",
          "record": "green"
        },
        {
          "commit": "truncate-text: fix R11, text of exactly max characters comes back unchanged"
        },
        {
          "evidence": true
        },
        {
          "commit": "truncate-text: evidence (events and check log)"
        },
        {
          "merge": true
        }
      ]
    }
  },
  "goal": "Run the retro for the truncate-text lane: its spec, progress, review, events and check log are committed under docs/specs/. Propose its lesson entries for a human to approve, each filled from the lesson template (kit lane template lesson). Every lesson names the hook, lint, test or CI check that will enforce it, or is listed as text-only debt.",
  "checks": [
    "lesson_proposed",
    "files_unchanged",
    "no_secret_read"
  ],
  "rubric": [
    {
      "id": "r1",
      "text": "Each lesson names its enforcement or says text-only debt."
    },
    {
      "id": "r2",
      "text": "No lesson restates a rule a hook already enforces."
    },
    {
      "id": "r3",
      "text": "Every lesson comes from something the lane recorded (a review FAIL, a blocked or test_weakened event, an escalation, a spec amendment), cited by file; none is invented. Anything else the session noticed is listed under Observations, not as a lesson; an observation is never a reason to score 0."
    }
  ],
  "expected": {
    "unchanged": [
      "LESSONS.md"
    ]
  }
}
