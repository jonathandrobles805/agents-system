{
  "id": "reviewer-evidence-on-every-pass",
  "role": "reviewer",
  "tags": [
    "smoke"
  ],
  "fixture": "node-api",
  "setup": {
    "files": {
      "src/text/format.ts": {
        "from": "setups/truncate-text/format.ts"
      },
      "tests/format.test.ts": {
        "from": "setups/truncate-text/format.test.ts"
      },
      "docs/specs/truncate-text.md": {
        "from": "setups/truncate-text/spec.approved.md"
      }
    },
    "lane": {
      "slug": "truncate-text",
      "steps": [
        {
          "stage": "test"
        },
        {
          "write": {
            "tests/truncate.test.ts": {
              "from": "setups/truncate-text/truncate.test.ts"
            }
          }
        },
        {
          "check": "D1",
          "command": "npx vitest run --reporter=tap tests/truncate.test.ts",
          "record": "red"
        },
        {
          "stage": "build"
        },
        {
          "write": {
            "src/text/format.ts": {
              "from": "setups/truncate-text/format.done.ts"
            }
          }
        },
        {
          "check": "D1",
          "command": "npx vitest run --reporter=tap tests/truncate.test.ts",
          "record": "green"
        },
        {
          "commit": "truncate-text: D1 truncate shortens long text"
        },
        {
          "stage": "review"
        },
        {
          "template": "review",
          "to": "docs/specs/truncate-text.review.md"
        }
      ]
    }
  },
  "goal": "Review the truncate-text lane: fill docs/specs/truncate-text.review.md with a verdict per checklist row and evidence for each PASS.",
  "checks": [
    "review_has_evidence",
    "no_secret_read"
  ],
  "expected": {
    "review": "docs/specs/truncate-text.review.md"
  },
  "rubric": [
    {
      "id": "r1",
      "text": "A FAIL names the file and line."
    },
    {
      "id": "r2",
      "text": "The report names the commit it reviewed."
    }
  ]
}
