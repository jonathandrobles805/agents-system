{
  "name": "node",
  "detect": [
    "package.json"
  ],
  "lockfiles": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lockb"
  ],
  "frameworks": {
    "next": "Next.js",
    "react": "React",
    "vue": "Vue",
    "express": "Express",
    "fastify": "Fastify",
    "nestjs": "NestJS",
    "@nestjs/core": "NestJS",
    "svelte": "Svelte",
    "remix": "Remix",
    "@remix-run/node": "Remix",
    "astro": "Astro",
    "hono": "Hono"
  },
  "tools": {
    "vitest": {
      "test": "npx vitest run",
      "test_affected": "npx vitest run --changed HEAD",
      "test_file": "npx vitest run {file}",
      "coverage": "npx vitest run --coverage.enabled --coverage.reporter=json-summary --coverage.reportsDirectory=coverage"
    },
    "jest": {
      "test": "npx jest --ci",
      "test_affected": "npx jest --ci --findRelatedTests {file}",
      "coverage": "npx jest --ci --coverage --coverageReporters=json-summary --coverageDirectory=coverage"
    },
    "mocha": {
      "test": "npx mocha"
    },
    "typescript": {
      "typecheck": "npx tsc --noEmit -p ."
    },
    "eslint": {
      "lint": "npx eslint {file}",
      "lint_all": "npx eslint ."
    },
    "biome": {
      "lint": "npx biome check {file}",
      "lint_all": "npx biome check ."
    },
    "dependency-cruiser": {
      "boundaries": "npx depcruise --config .dependency-cruiser.cjs src"
    },
    "@stryker-mutator/core": {
      "mutation": "npx stryker run"
    },
    "stylelint": {
      "tokens_lint": "npx stylelint \"**/*.{css,scss}\""
    },
    "prettier": {
      "format": "npx prettier --check ."
    }
  },
  "audit": "node \"$HOME/.claude/kit/scripts/ci_audit.js\" --repo .",
  "test_dirs": [
    "test",
    "tests",
    "__tests__",
    "spec"
  ],
  "source_dirs": [
    "src",
    "app",
    "lib",
    "packages"
  ],
  "install_hint": {
    "boundaries": "npm i -D dependency-cruiser",
    "mutation": "npm i -D @stryker-mutator/core",
    "typecheck": "npm i -D typescript"
  },
  "results": [
    {
      "name": "tap",
      "fail": "^not ok \\d+ - (.+?)(?: # .*)?$",
      "pass": "^ok \\d+ - (.+?)(?: # .*)?$"
    },
    {
      "name": "vitest/jest",
      "fail": "^\\s*(?:\u00d7|\u2715|\u2717)\\s+(.+?)(?:\\s+\\d+\\s*ms)?$",
      "pass": "^\\s*(?:\u2713|\u221a)\\s+(.+?)(?:\\s+\\d+\\s*ms)?$"
    }
  ]
}
